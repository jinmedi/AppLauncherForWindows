<Window x:Class="AppLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppLauncher.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="App Launcher"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="24"
            Padding="20,18"
            CornerRadius="14"
            Background="{DynamicResource Launcher.SurfaceBrush}"
            BorderBrush="{DynamicResource Launcher.BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.35" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBox x:Name="QueryBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="24"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Launcher.TextBrush}"
                         CaretBrush="{DynamicResource Launcher.TextBrush}"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="앱 이름을 입력하세요"
                           FontSize="24"
                           Foreground="{DynamicResource Launcher.MutedTextBrush}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsQueryEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Rectangle Height="1" Margin="0,14,0,10" Fill="{DynamicResource Launcher.BorderBrush}" />

            <TextBlock Text="{Binding HintText}"
                       FontSize="12"
                       Foreground="{DynamicResource Launcher.MutedTextBrush}" />
        </StackPanel>
    </Border>
</Window>
