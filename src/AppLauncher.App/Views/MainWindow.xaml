<Window x:Class="AppLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppLauncher.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="App Launcher"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Launcher.HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Launcher.SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnResultClicked" />
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="24"
            Padding="20,18,20,14"
            CornerRadius="14"
            Background="{DynamicResource Launcher.SurfaceBrush}"
            BorderBrush="{DynamicResource Launcher.BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.35" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBox x:Name="QueryBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="24"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Launcher.TextBrush}"
                         CaretBrush="{DynamicResource Launcher.TextBrush}"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="앱 이름을 입력하세요"
                           FontSize="24"
                           Foreground="{DynamicResource Launcher.MutedTextBrush}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsQueryEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <ListBox x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                     Margin="-10,12,-10,0"
                     MaxHeight="460"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnResultsSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}"
                                   Width="28" Height="28"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="{DynamicResource Launcher.TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource Launcher.MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Launcher.HoverBrush}">
                                <TextBlock Text="{Binding Kind}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Launcher.MutedTextBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Rectangle Height="1" Margin="0,12,0,8" Fill="{DynamicResource Launcher.BorderBrush}" />

            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource Launcher.MutedTextBrush}" />
                <TextBlock Text="{Binding HintText}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Launcher.MutedTextBrush}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
